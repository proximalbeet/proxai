# Allow-list: only the agent definition and its own tools are tracked.
# Keys (.env), logins (auth.json), memory, sessions and Hermes bundled skills stay out.
*
!.gitignore
!SOUL.md
!SOUL.gru.md
!config.yaml
!profile.yaml
!README.md
!skills/
# Your own skills: add two lines per skill folder, e.g.
#   !skills/quote-calculator/
#   !skills/quote-calculator/**
!skills/knowledge/
!skills/knowledge/**
!skills/openclaw-imports/
!skills/openclaw-imports/**

# Never commit, even inside allowed folders
.env
*.pth
*.onnx
__pycache__/
.venv/
node_modules/

# Profile plugins
!plugins/
!plugins/discord-routing/
!plugins/discord-routing/**
!plugins/claude-code-delegation/
!plugins/claude-code-delegation/**
# Phase 9 calendar plugin (its token lives in google-calendar/, which stays out)
!plugins/proxai-calendar/
!plugins/proxai-calendar/**
__pycache__/

# Vault refiler (host-side, files _inbox notes)
!refiler/
!refiler/**
__pycache__/

# Phase 8 vault git sync (host-side timer) + its Hermes status plugin
!vault-sync/
!vault-sync/**
!plugins/vault-sync/
!plugins/vault-sync/**
__pycache__/

# Phase 7 sandbox: image, egress proxy scripts and allow-list (state in egress/ stays out)
!sandbox/
!sandbox/build-image.sh
!sandbox/image/
!sandbox/image/**
!sandbox/egress/
!sandbox/egress/**
!sandbox/gateway/
!sandbox/gateway/**
# Phase 15 ProxAI apps: example app + builder test (builder itself is in image/)
!sandbox/apps-example/
!sandbox/apps-example/**
!sandbox/test_app_build.py

# Voice pipeline scripts only (no models, reference audio or virtualenvs)
!voice/
!voice/tts_pipeline.py
!voice/tts_rvc.py
!voice/spoken_text.py
!voice/test_spoken_text.py
!voice/pronunciations.json

# Community plugin, pinned copy of the reviewed commit (fastfinge/hermes-session-reset-policy 493df02)
!plugins/hermes-session-reset-policy/
!plugins/hermes-session-reset-policy/**
__pycache__/

# Phase 10 server/personal mode: switch engine, modes.toml, plugin (state lives in ~/.local/state/proxai)
!mode/
!mode/**
!plugins/proxai-mode/
!plugins/proxai-mode/**
!voice/test_tts_mode.py
__pycache__/

# Vault writes with Nathan's permission (policy.json = folder rules)
!plugins/proxai-vault-write/
!plugins/proxai-vault-write/**
# Phase 15 ProxAI apps plugin
!plugins/proxai-apps/
!plugins/proxai-apps/**
!plugins/proxai-pc-stats/
!plugins/proxai-pc-stats/**
!plugins/proxai-context/
!plugins/proxai-context/**
!plugins/proxai-github/
!plugins/proxai-github/**
!plugins/proxai-style/
!plugins/proxai-style/**
__pycache__/
